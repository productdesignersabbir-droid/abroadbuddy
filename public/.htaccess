Options -Indexes

RewriteEngine On

# Always use https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Next.js file names change on every build, so they can be cached for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# The home-screen icon is saved without a file extension
<Files "apple-icon">
  ForceType image/png
</Files>
